{#- 지난 리포트 목록 페이지 (주제별): docs/<주제>/index.html -#}
{% extends "base.html.j2" %}
{% import "partials/components.html.j2" as c %}
{% block title %}{{ topic_title }} · 지난 리포트{% endblock %}
{% block content %}
<tr>
  <td style="padding:8px 0 20px;">
    {% if home_url %}<a href="{{ home_url }}" style="color:{{ t.colors.text_faint }};font-size:{{ t.sizes.small }};text-decoration:none;">← 전체 주제</a>{% endif %}
    <h1 class="rp-title" style="margin:8px 0 0;color:{{ t.colors.text }};font-size:{{ t.sizes.title }};font-weight:800;line-height:1.3;">{{ topic_title }}</h1>
    {% if description %}<p style="margin:10px 0 0;color:{{ t.colors.text_muted }};">{{ description }}</p>{% endif %}
  </td>
</tr>
{% for e in entries %}
<tr>
  <td class="rp-card" bgcolor="{{ t.colors.surface }}" style="padding:{{ t.layout.card_padding }};background:{{ t.colors.surface }};border:1px solid {{ t.colors.border }};border-radius:{{ t.layout.radius }};">
    <a href="{{ e.href }}" style="text-decoration:none;">
      <div style="color:{{ t.colors.accent }};font-size:{{ t.sizes.tiny }};font-weight:700;">{{ "주간 정리" if e.mode == "weekly" else "데일리" }} · {{ e.count }}건</div>
      <div class="rp-item-title" style="margin-top:4px;color:{{ t.colors.text }};font-size:{{ t.sizes.item }};font-weight:700;">{{ e.date_label }}</div>
      {% if e.one_liner %}<p style="margin:8px 0 0;color:{{ t.colors.text_muted }};font-size:{{ t.sizes.small }};line-height:1.6;">{{ e.one_liner }}</p>{% endif %}
    </a>
  </td>
</tr>
{{ c.spacer() }}
{% else %}
<tr><td style="color:{{ t.colors.text_muted }};">아직 리포트가 없어요.</td></tr>
{% endfor %}
{% endblock %}
