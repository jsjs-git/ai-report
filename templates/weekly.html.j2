{#- 주간 정리: 이번 주 흐름 3가지 + 항목은 3줄 요약만 -#}
{% extends "base.html.j2" %}
{% import "partials/components.html.j2" as c %}
{% block title %}{{ report.title }} · 주간 정리 {{ report.date | kdate_short }}{% endblock %}
{% block content %}
{% include "partials/header.html.j2" %}

{% if report.trends %}
<tr>
  <td style="padding:16px 0 12px;">
    <h2 style="margin:0;color:{{ t.colors.text }};font-size:{{ t.sizes.section }};font-weight:800;">
      <span style="display:inline-block;width:4px;height:18px;margin-right:8px;vertical-align:-2px;background:{{ t.colors.accent }};border-radius:2px;"></span>이번 주 핵심 흐름
    </h2>
  </td>
</tr>
{% for trend in report.trends %}
<tr>
  <td class="rp-card" bgcolor="{{ t.colors.surface }}" style="padding:{{ t.layout.card_padding }};background:{{ t.colors.surface }};border:1px solid {{ t.colors.border }};border-radius:{{ t.layout.radius }};">
    <div style="color:{{ t.colors.accent }};font-size:{{ t.sizes.tiny }};font-weight:700;">흐름 {{ loop.index }}</div>
    <div class="rp-item-title" style="margin-top:4px;color:{{ t.colors.text }};font-size:{{ t.sizes.item }};font-weight:700;line-height:1.45;">{{ trend.title }}</div>
    <p style="margin:10px 0 0;color:{{ t.colors.text }};font-size:{{ t.sizes.base }};line-height:{{ t.sizes.line_height }};">{{ trend.explanation }}</p>
  </td>
</tr>
{{ c.spacer() }}
{% endfor %}
{% endif %}

{% set detail = "brief" %}
{% for section in report.sections if section.items %}
  {% include "partials/section.html.j2" %}
{% endfor %}
{% include "partials/footer.html.j2" %}
{% endblock %}
