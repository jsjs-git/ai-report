# ─────────────────────────────────────────────────────────────
# 비밀값 양식 파일
# 1) 이 파일을 복사해서 이름을 ".env" 로 바꾸세요.
# 2) 아래 값을 채우세요. (.env 는 git에 올라가지 않아요)
# 3) 쓰지 않는 채널의 값은 비워둬도 돼요.
# ─────────────────────────────────────────────────────────────

# [요약] Claude API 키 — https://platform.claude.com 에서 발급
ANTHROPIC_API_KEY=

# [이메일] Gmail 주소와 "앱 비밀번호" (일반 비밀번호 아님! README 5장 참고)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# 리포트를 받을 주소 (여러 개면 쉼표로 구분). 비우면 GMAIL_ADDRESS로 보내요.
REPORT_EMAIL_TO=

# [웹] 웹 리포트가 올라갈 주소 (GitHub Pages). 끝에 / 를 붙이세요.
# 예: https://myname.github.io/mailing_service/
REPORT_BASE_URL=

# [카카오톡] README 6장 참고
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5000/callback
# 처음 인증(python -m reporter.tools.kakao_auth) 후 자동 저장돼요.
# GitHub Actions에서 돌릴 때만 GitHub Secret에 직접 넣어요.
KAKAO_REFRESH_TOKEN=

# [선택] 있으면 더 안정적으로 수집돼요 (없어도 동작)
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_API_TOKEN=
